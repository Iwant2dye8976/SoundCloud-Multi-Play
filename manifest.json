{
  "manifest_version": 3,
  "name": "SoundCloud Multi-Play",
  "version": "1.1.0",
  "description": "Allow SoundCloud to keep playing across tabs and devices, with mini-player controls, progress bar, and track downloader.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.soundcloud.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "SoundCloud Multi-Play"
  },
  "content_scripts": [
    {
      "matches": ["*://*.soundcloud.com/*"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.soundcloud.com/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
