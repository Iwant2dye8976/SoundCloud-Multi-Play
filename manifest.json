{
  "manifest_version": 3,
  "name": "SoundCloud Multi-Play",
  "version": "1.6.1",
  "description": "Allow SoundCloud to keep playing across tabs and devices, with mini-player controls, progress bar, track downloader, and LAN mobile remote.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.soundcloud.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-play": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Play or pause SoundCloud"
    },
    "next-track": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Skip to next SoundCloud track"
    },
    "prev-track": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Skip to previous SoundCloud track"
    },
    "like-track": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Like or unlike current SoundCloud track"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "SoundCloud Multi-Play"
  },
  "content_scripts": [
    {
      "matches": ["*://*.soundcloud.com/*"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.soundcloud.com/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
